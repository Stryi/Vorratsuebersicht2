<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.Vorratsuebersicht" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->

        <!-- Hintergrundfarbe für Buttons -->
        <item name="colorPrimary">#BBBBBB</item>

        <!-- Textfarbe für Buttons -->
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Suchen Icon in der AppBar -->
        <item name="android:colorControlNormal">@color/white</item>

        <!-- Link-Farbe für TextView -->
        <item name="android:textColorLink">#0000AA</item>

        <!-- Farbe für RadioButton -->
        <item name="radioButtonStyle">@style/MyRadioButton</item>

        <!-- Farbe für ein Switch -->
        <item name="switchStyle">@style/MySwitch</item>

    </style>

    <style name="MyRadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="buttonTint">@color/radiobutton_tint</item>
    </style>

    <style name="MySwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb_tint</item>
        <item name="trackTint">@color/switch_track_tint</item>
    </style>

    <!-- AlertDialog -->
    <style name="MyAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/MyDialogButtonPositive</item>
        <item name="buttonBarNegativeButtonStyle">@style/MyDialogButtonNegative</item>
        <item name="buttonBarNeutralButtonStyle">@style/MyDialogButtonNegative</item>
    </style>

    <style name="MyDialogButtonPositive" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#000000</item>
    </style>

    <style name="MyDialogButtonNegative" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#000000</item>
    </style>

    <style name="Theme.Vorratsuebersicht" parent="Base.Theme.Vorratsuebersicht" />

    <style name="Theme.Vorratsuebersicht.NoActionBar">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Widget.MyApp.SearchView" parent="Widget.AppCompat.SearchView">
        <item name="queryHint">Suche...</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Theme.Vorratsuebersicht.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Vorratsuebersicht.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="Theme.VorratsuebersichtNeu.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.VorratsuebersichtNeu.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.VorratsuebersichtNeu.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
    <!-- Base application theme. -->
    <style name="Base.Theme.VorratsuebersichtNeu" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.VorratsuebersichtNeu" parent="Base.Theme.VorratsuebersichtNeu" />
</resources>