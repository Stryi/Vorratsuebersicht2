<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/StorageItemList_RootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="0dp"
    android:fitsSystemWindows="true"
    tools:context=".StorageItemListActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/StorageItemList_AppBar"
        app:title="@string/StorageItem_Title"
        app:titleTextColor="@color/Application_ActionBar_TextColor"
        app:subtitleTextColor="@color/Application_ActionBar_TextColor2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"
        android:background="@color/Application_ActionBar_Background"
        app:navigationIconTint="@color/Application_ActionBar_TextColor"
        app:navigationIcon="@drawable/arrow_back_24px"
        app:iconTint="@color/Application_ActionBar_TextColor"
        app:menu="@menu/storage_item_list_menu"  />

    <!-- Auswahl Lager -->
    <LinearLayout
        android:id="@+id/StorageItemList_SelectStorageSection"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible" >
        <TextView
            android:id="@+id/StorageItemList_TextStorage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:textSize="20sp"
            android:text="@string/StorageItem_Storage" />
        <Spinner
            android:id="@+id/StorageItemList_Storages"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:padding="10dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/StorageItemList_LoadingIndicator"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminate="true"
            app:indicatorSize="64dp"
            app:trackThickness="6dp"/>
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/StorageItemView_SwipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ListView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/StorageItemView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="visible"
            android:layout_weight="1" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Footer -->
    <TextView
        android:id="@+id/StorageItemList_Footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/Footer_Color"
        android:background="@color/Footer_Background"
        android:textSize="15sp"
        android:padding="5dp" />

</LinearLayout>
